@InProceedings{hernandez2015model,
author="Hern{\'a}ndez, Carlos
and Fern{\'a}ndez, Jos{\'e} L.
and S{\'a}nchez-Escribano, Guadalupe
and Bermejo-Alonso, Julita
and Sanz, Ricardo",
editor="Liu, Honghai
and Kubota, Naoyuki
